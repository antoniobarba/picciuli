# Copy to /opt/picciuli/.env on the server, fill in every value, then:
#   chmod 600 .env
# Never commit the real file. Keep a copy of it in your password manager:
# without ZITADEL_MASTERKEY the identity database cannot be decrypted.

# --- Domains (DNS A/AAAA records pointing to the server) --------------------
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
# The web front-end, and the names redirecting to it (comma-separated, optional).
APP_DOMAIN=app.example.com
WEB_REDIRECT_DOMAINS=www.example.com, example.com
# Let's Encrypt account e-mail (certificate expiry notices).
ACME_EMAIL=you@example.com

# --- Picciuli API ------------------------------------------------------------
# Image tags deployed by deploy.sh (commit SHA). Managed automatically.
API_TAG=latest
WEB_TAG=latest
# Zitadel project id: the audience of the access tokens.
OIDC_AUDIENCE=
# Client id of the Zitadel application used by Swagger UI (optional).
SWAGGER_CLIENT_ID=
SWAGGER_SCOPES=openid profile email
# Client id of the Zitadel application of the web front-end.
WEB_CLIENT_ID=
# Origins of the web frontend, comma-separated (e.g. https://app.example.com).
CORS_ORIGINS=
# How long quotes and exchange rates are shared between users, in seconds.
PRICE_CACHE_SECONDS=900

# --- Zitadel -----------------------------------------------------------------
ZITADEL_VERSION=v4.16.0
# Exactly 32 characters, generated once and never changed:
#   tr -dc A-Za-z0-9 </dev/urandom | head -c 32
ZITADEL_MASTERKEY=
# At least 32 characters: openssl rand -base64 32
LOGIN_SESSION_COOKIE_SECRET=
# Initial administrator (only used on the very first start). The password
# needs 8+ characters with upper and lower case letters, a digit and a symbol.
ZITADEL_ORG_NAME=Picciuli
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=
# Letters and digits only (it is embedded in a connection URL):
#   tr -dc A-Za-z0-9 </dev/urandom | head -c 32
POSTGRES_PASSWORD=
