# Caddy obtains and renews the HTTPS certificates automatically.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8000
}

{$APP_DOMAIN} {
	@identity path /api/auth/*
	handle @identity {
		header Cache-Control no-store
		header Referrer-Policy no-referrer
		request_body {
			max_size 16KB
		}
		reverse_proxy api:8000
	}
	@loginPages path /login /verify-email /reset-password /callback
	header @loginPages Referrer-Policy no-referrer
	reverse_proxy web:8080
}

# Other names of the front-end (e.g. "www.example.com, example.com") redirect
# to it. The placeholder address only matches a host that does not exist.
{$WEB_REDIRECT_DOMAINS:http://redirect.invalid} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$AUTH_DOMAIN} {
	# Zitadel: the Login UI (Next.js) under /ui/v2/login, everything else
	# (OIDC endpoints, console, gRPC APIs) to the core over HTTP/2 cleartext.
	@root path /
	rewrite @root /ui/v2/login/
	handle /ui/v2/login* {
		reverse_proxy zitadel-login:3000
	}
	handle {
		reverse_proxy h2c://zitadel-api:8080
	}
}
