# Settings of `npm run dev`. The API is reached through the Vite proxy (see
# vite.config.ts; PICCIULI_API_PROXY changes its target), so VITE_API_URL is
# empty. Override any value in .env.development.local (not committed).
VITE_API_URL=
VITE_OIDC_ISSUER=https://auth.picciuli.party
# Zitadel application "Picciuli front-end (development)", redirect URI
# http://localhost:5173/callback.
VITE_OIDC_CLIENT_ID=399662274471591940
VITE_OIDC_PROJECT_ID=399656432997236740
