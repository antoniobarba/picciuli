/* Shared layout */

.pane-title {
    height: auto;
    padding: 0 1;
    background: $panel;
}

.pane-footer {
    height: auto;
    padding: 0 1;
}

ListTable {
    height: 1fr;
}

/* Overview */

#overview {
    height: 1fr;
}

#calendar-pane {
    width: 3fr;
    min-width: 31;
    max-width: 130;
    padding: 0 1;
}

#period-title {
    height: auto;
    padding-bottom: 1;
}

#period-totals {
    height: auto;
    padding-top: 1;
    content-align: center middle;
    width: 100%;
}

#detail-pane {
    width: 2fr;
    min-width: 50;
}

#day-list {
    height: auto;
    max-height: 50%;
    min-height: 3;
}

#period-scroll {
    height: 1fr;
    padding: 1 1 0 1;
}

.-narrow #overview {
    layout: vertical;
    overflow-y: auto;
}

.-narrow #calendar-pane {
    width: 100%;
    max-width: 100%;
    height: auto;
}

.-narrow CalendarWidget {
    height: 21;
}

.-narrow #detail-pane {
    width: 100%;
    min-width: 0;
    height: auto;
}

.-narrow #period-scroll {
    height: auto;
}

/* Dialogs */

ModalScreen {
    align: center middle;
}

.dialog {
    width: 76;
    max-width: 96%;
    height: auto;
    max-height: 92%;
    overflow-y: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.dialog.wide {
    width: 104;
}

.dialog.help {
    width: 84;
    height: 90%;
}

.dialog-title {
    text-style: bold;
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
}

.form-grid {
    grid-size: 2;
    grid-columns: 18 1fr;
    grid-rows: 1;
    grid-gutter: 1 1;
    height: auto;
    margin-bottom: 1;
}

.form-grid Label {
    color: $text-muted;
}

.form-help {
    color: $text-muted;
    margin-top: 1;
}

.question {
    width: 100%;
    margin-bottom: 1;
}

.buttons {
    height: auto;
    align: right middle;
    margin-top: 1;
}

.buttons Button {
    margin-left: 2;
}

/* Split editor */

#split-editor {
    height: auto;
    margin-bottom: 1;
}

#lines {
    height: auto;
    max-height: 12;
    margin: 1 0;
}

.split-line {
    height: 1;
    margin-bottom: 1;
}

.line-target {
    width: 2fr;
    margin-right: 1;
}

.line-amount {
    width: 14;
    margin-right: 1;
}

.line-shares {
    width: auto;
    max-width: 16;
    margin-right: 1;
    color: $text-muted;
}

.line-memo {
    width: 1fr;
    margin-right: 1;
}

.line-remove {
    min-width: 3;
    width: 3;
}

.split-footer {
    height: auto;
}

#difference {
    width: 1fr;
    padding: 0 0 0 2;
}
